{
  "name": "mcp-accounts",
  "version": "0.3.3",
  "description": "A local-first macOS profile manager for multiple accounts on the same MCP server.",
  "main": "electron/main.cjs",
  "author": "Brooke Roney",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build",
    "package:mac": "npm run build && electron-builder --mac dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "electron tests/electron-smoke.cjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "40.8.0",
    "electron-builder": "26.0.20",
    "typescript": "5.8.3",
    "vite": "6.1.0",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "com.brookeroney.mcpaccounts",
    "productName": "MCP Accounts",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "MCP Accounts ${version}"
    }
  }
}
